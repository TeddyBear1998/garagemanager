// Cloudflare Worker that serves the GearBear website at gearbear.impatientbeaststudios.com.
// The site files sit in the repo root; .assetsignore keeps the rest out.
{
  "name": "gearbear",
  "compatibility_date": "2026-11-01",
  // worker.js only answers /video/* (Safari needs part-of-file answers to play a video).
  "main": "worker.js",
  "assets": { "directory": ".", "binding": "ASSETS", "run_worker_first": ["/video/*"] }
}
